rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cho phép truy cập không cần xác thực
    // Bảo mật dựa trên độ khó đoán của Sync Key (SHA-256 hash)
    match /sync_data/{hashKey} {
      // Document gốc - cho phép đọc để kiểm tra tồn tại
      allow get: if true;
      
      // Subcollection notes dưới mỗi hashKey
      match /notes/{noteId} {
        // Cho phép đọc và ghi không cần auth
        // Chỉ người biết hashKey mới truy cập được đường dẫn này
        allow read, write: if true;
      }

      // Folder là metadata song song với notes; note giữ field folderId để tương thích dữ liệu cũ.
      match /folders/{folderId} {
        allow read, create, update: if true;
        // Bản folder v1 chưa có UI xóa folder, nên không mở delete.
        allow delete: if false;
      }
    }
    
    // Từ chối mọi truy cập khác
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
